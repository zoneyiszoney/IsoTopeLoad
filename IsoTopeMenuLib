-- Mobile check
local isMobile = (function()
	local hasTouch = false
	pcall(function() hasTouch = UserInputService.TouchEnabled end)
	local hasKeyboard = false
	pcall(function() hasKeyboard = UserInputService.KeyboardEnabled end)
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	return (hasTouch and not hasKeyboard) or (hasTouch and (vp.X < 900 or vp.Y < 600))
end)()

