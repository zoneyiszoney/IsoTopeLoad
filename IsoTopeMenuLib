			TweenService:Create(holder, TweenInfo.new(0.16), { BackgroundColor3 = targetColor }):Play()
		end
		update()

		hit.MouseButton1Click:Connect(function()
			state = not state
			update()
			if callback then pcall(callback, state) end
		end)

		return {
