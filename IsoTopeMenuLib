	local function makeSlider(card, minOrOpts, max, default, callback, isFloat, unit)
		local min, def, cb, isF, u
		if typeof(minOrOpts) == "table" then
			min = minOrOpts.Min or 0
			max = minOrOpts.Max or 100
			def = minOrOpts.Default or min
			u = minOrOpts.Suffix or ""
			cb = minOrOpts.Callback
			isF = minOrOpts.IsFloat or (minOrOpts.Step and minOrOpts.Step < 1)
		else
			min = minOrOpts or 0
			max = max or 100
			def = default or min
			cb = callback
			isF = isFloat
			u = unit or ""
		end
		def = math.clamp(def or min, min, max)

		local container = Instance.new("Frame", card)
		container.Size = UDim2.fromOffset(128, 28)
		container.Position = UDim2.new(1, -140, 0.5, -14)
		container.BackgroundTransparency = 1
