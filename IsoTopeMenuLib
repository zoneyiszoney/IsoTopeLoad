		local themeCard = sTab:CreateCard({
			Title = "Theme Preset",
			Description = "Choose visual palette (8 options)"
		})
		local themes = { "Dark", "Emerald", "Blue", "Purple", "AMOLED", "Cyberpunk", "Sunset", "Monokai" }
		local tIdx = 1

		local themeBtn = Instance.new("TextButton", themeCard.Card)
		themeBtn.Size = UDim2.fromOffset(105, 28)
		themeBtn.Position = UDim2.new(1, -118, 0.5, -14)
		themeBtn.BackgroundColor3 = win.THEME.control
		themeBtn.Text = "Dark"
		themeBtn.TextColor3 = win.THEME.text
		themeBtn.Font = Enum.Font.GothamMedium
		themeBtn.TextSize = 9
		themeBtn.AutoButtonColor = false
		Instance.new("UICorner", themeBtn).CornerRadius = UDim.new(0, 8)

		themeBtn.MouseButton1Click:Connect(function()
			tIdx = (tIdx % #themes) + 1
			themeBtn.Text = themes[tIdx]
			win.ApplyTheme(themes[tIdx])
		end)

		-- Accent Colors Palette (8 Colors)
		local accentCard = sTab:CreateCard({
			Title = "Accent Color",
			Description = "Cycle 8 glowing accent styles"
		})
		local aIdx = 1
		local accentBtn = Instance.new("TextButton", accentCard.Card)
		accentBtn.Size = UDim2.fromOffset(105, 28)
		accentBtn.Position = UDim2.new(1, -118, 0.5, -14)
		accentBtn.BackgroundColor3 = win.THEME.accent
		accentBtn.Text = ACCENT_PALETTE[1].name
		accentBtn.TextColor3 = Color3.fromRGB(15, 20, 25)
		accentBtn.Font = Enum.Font.GothamBold
		accentBtn.TextSize = 8
		accentBtn.AutoButtonColor = false
		Instance.new("UICorner", accentBtn).CornerRadius = UDim.new(0, 8)

		accentBtn.MouseButton1Click:Connect(function()
			aIdx = (aIdx % #ACCENT_PALETTE) + 1
			local item = ACCENT_PALETTE[aIdx]
			accentBtn.Text = item.name
			accentBtn.BackgroundColor3 = item.color
			win.SetAccentColor(item.color)
		end)

		-- Rainbow RGB Mode
		sTab:CreateToggle({
			Title = "Rainbow RGB Mode",
			Description = "Smooth dynamic RGB color cycle on accents",
			Default = false,
			Callback = function(v)
				win.UI.RainbowMode = v
			end
		})

		-- Anonymous Mode
		sTab:CreateToggle({
			Title = "Anonymous Mode",
			Description = "Hide your Roblox nickname across all UI",
			Default = false,
			Callback = function(v)
				win.SetAnonymousMode(v)
			end
		})

		-- Window Opacity
		local opacities = {
			{ name = "Solid (5%)", val = 0.05 },
			{ name = "Normal (16%)", val = 0.16 },
			{ name = "Glass (28%)", val = 0.28 },
			{ name = "Clear (45%)", val = 0.45 },
		}
		local opIdx = 2
		local opCard = sTab:CreateCard({
			Title = "Window Opacity",
			Description = "Glass transparency level"
		})
		local opBtn = Instance.new("TextButton", opCard.Card)
		opBtn.Size = UDim2.fromOffset(105, 28)
		opBtn.Position = UDim2.new(1, -118, 0.5, -14)
		opBtn.BackgroundColor3 = win.THEME.control
		opBtn.Text = opacities[opIdx].name
		opBtn.TextColor3 = win.THEME.text
		opBtn.Font = Enum.Font.GothamMedium
		opBtn.TextSize = 8
		opBtn.AutoButtonColor = false
		Instance.new("UICorner", opBtn).CornerRadius = UDim.new(0, 8)

		opBtn.MouseButton1Click:Connect(function()
			opIdx = (opIdx % #opacities) + 1
			opBtn.Text = opacities[opIdx].name
			win.MainFrame.BackgroundTransparency = opacities[opIdx].val
		end)

		-- Border Outline
		local outlines = {
			{ name = "Vibrant (20%)", val = 0.20 },
			{ name = "Standard (48%)", val = 0.48 },
			{ name = "Subtle (75%)", val = 0.75 },
			{ name = "None (100%)", val = 1.00 },
		}
		local outIdx = 2
		local outCard = sTab:CreateCard({
			Title = "Border Outline",
			Description = "Frame border glow & stroke intensity"
		})
		local outBtn = Instance.new("TextButton", outCard.Card)
		outBtn.Size = UDim2.fromOffset(105, 28)
		outBtn.Position = UDim2.new(1, -118, 0.5, -14)
		outBtn.BackgroundColor3 = win.THEME.control
		outBtn.Text = outlines[outIdx].name
		outBtn.TextColor3 = win.THEME.text
		outBtn.Font = Enum.Font.GothamMedium
		outBtn.TextSize = 8
		outBtn.AutoButtonColor = false
		Instance.new("UICorner", outBtn).CornerRadius = UDim.new(0, 8)

		outBtn.MouseButton1Click:Connect(function()
			outIdx = (outIdx % #outlines) + 1
			outBtn.Text = outlines[outIdx].name
			local s = win.MainFrame:FindFirstChildOfClass("UIStroke")
			if s then s.Transparency = outlines[outIdx].val end
		end)

		-- Performance & GPU Saver
		sTab:CreateSection("Performance & Optimization")

		sTab:CreateToggle({
			Title = "Disable 3D Rendering",
			Description = "GPU Saver: black viewport to cut 95% GPU load",
			Default = false,
			Callback = function(v)
				pcall(function()
					RunService:Set3dRenderingEnabled(not v)
				end)
			end
		})

		sTab:CreateButton({
			Title = "FPS Boost",
			Description = "Lowers shadows & particle post-effects",
			ButtonText = "BOOST",
			Callback = function()
				pcall(function()
					Lighting.GlobalShadows = false
					Lighting.FogEnd = 9e9
					for _, v in ipairs(Lighting:GetChildren()) do
						if v:IsA("PostEffect") then v.Enabled = false end
					end
				end)
			end
		})

		sTab:CreateSlider({
			Title = "FPS Cap Limit",
			Description = "Lock frame rate to save battery / CPU",
			Min = 30,
			Max = 240,
			Default = 60,
			Suffix = " fps",
			Callback = function(v)
				pcall(function()
					if setfpscap then setfpscap(v) end
				end)
			end
		})

		win:SetStatus("READY")
	end
end)

return IsoTopeUI
