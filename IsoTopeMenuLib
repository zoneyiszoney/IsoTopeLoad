		local Tab = { Frame = frame }

		function Tab:CreateSection(text)
			return createSectionTitle(frame, text)
		end

		function Tab:CreateCard(opts)
			local title = type(opts) == "table" and (opts.Title or opts.Name) or tostring(opts or "Card")
			local desc = type(opts) == "table" and (opts.Description or opts.Desc) or ""
			local c = createCard(frame, title, desc)
			local tLbl = c:FindFirstChild("TextLabel")
			local dLbl = nil
			for _, child in ipairs(c:GetChildren()) do
				if child:IsA("TextLabel") and child ~= tLbl then
					dLbl = child
					break
				end
			end
			return {
				Card = c,
				SetTitle = function(self, t) if tLbl then tLbl.Text = tostring(t) end end,
				SetDesc = function(self, d) if dLbl then dLbl.Text = tostring(d) end end
			}
		end

