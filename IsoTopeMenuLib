	local function setCollapsed(state)
		if collapsed == state then return end
		collapsed = state

		Content.Visible = not state
		if StatsBar then StatsBar.Visible = not state end
		Tabs.Visible = not state
		footer.Visible = not state
		-- Hide resize handle arrow ↘ so it never shows in collapsed topbar
		if handle then handle.Visible = not state end

		local currentWidth = MainFrame.Size.X.Offset
		if currentWidth < 380 then currentWidth = 470 end

		if state then
			if MainFrame.Size.Y.Offset > 100 then
				expandedHeight = MainFrame.Size.Y.Offset
			end
			local target = UDim2.fromOffset(currentWidth, collapsedHeight)
			TweenService:Create(MainFrame, TweenInfo.new(UI.AnimationTime, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Size = target,
				BackgroundTransparency = 1,
			}):Play()
			TweenService:Create(mainStroke, TweenInfo.new(UI.AnimationTime, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Transparency = 1,
			}):Play()
			HideBtn.Text = "▼"
		else
			local target = UDim2.fromOffset(currentWidth, expandedHeight)
			TweenService:Create(MainFrame, TweenInfo.new(UI.AnimationTime, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Size = target,
				BackgroundTransparency = UI.BackgroundTransparency,
			}):Play()
			TweenService:Create(mainStroke, TweenInfo.new(UI.AnimationTime, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Transparency = UI.StrokeTransparency,
			}):Play()
			HideBtn.Text = "▲"
		end
	end

