			Default = false,
			Callback = function(v)
				pcall(function()
					RunService:Set3dRenderingEnabled(not v)
				end)
			end
		})

		sTab:CreateButton({
			Title = "FPS Boost",
			Description = "Lowers shadows & particle post-effects",
