		pcall(function()
			glassGradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, THEME.panel or THEME.bg),
				ColorSequenceKeypoint.new(0.5, THEME.bg),
				ColorSequenceKeypoint.new(1, THEME.bg),
			})
		end)
		if mobBtn then
			mobBtn.BackgroundColor3 = THEME.panel
			mobBtn.TextColor3 = THEME.accent
		end
		for _, card in ipairs(styleCards) do
			if card and card.Parent then
				card.BackgroundColor3 = THEME.card
				local s = card:FindFirstChildOfClass("UIStroke")
				if s then s.Color = THEME.stroke end
				local n = card:FindFirstChild("Title")
				if n then n.TextColor3 = THEME.text end
				local d = card:FindFirstChild("Desc")
				if d then d.TextColor3 = THEME.sub end
				local bar = card:FindFirstChild("Frame")
				if bar then bar.BackgroundColor3 = THEME.blue or THEME.accent end
			end
		end
		updateTabVisuals()
	end

