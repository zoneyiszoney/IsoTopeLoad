	local function makeSlider(card, opts)
		opts = opts or {}
		local min = opts.Min or 0
		local max = opts.Max or 100
		local def = opts.Default or min
		local suffix = opts.Suffix or ""
		local callback = opts.Callback

		card.Size = UDim2.new(1, -4, 0, 68)

		local valLabel = Instance.new("TextLabel", card)
		valLabel.Size = UDim2.fromOffset(60, 20)
		valLabel.Position = UDim2.new(1, -72, 0, 8)
		valLabel.BackgroundTransparency = 1
		valLabel.Text = tostring(def) .. suffix
		valLabel.TextColor3 = THEME.accent
		valLabel.Font = Enum.Font.GothamBold
		valLabel.TextSize = 11
		valLabel.TextXAlignment = Enum.TextXAlignment.Right

		local track = Instance.new("Frame", card)
		track.Size = UDim2.new(1, -30, 0, 6)
		track.Position = UDim2.fromOffset(15, 48)
		track.BackgroundColor3 = THEME.control
		Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

		local fill = Instance.new("Frame", track)
		fill.Size = UDim2.new(math.clamp((def - min) / (max - min), 0, 1), 0, 1, 0)
		fill.BackgroundColor3 = THEME.accent
		Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

		local knob = Instance.new("Frame", track)
		knob.Size = UDim2.fromOffset(14, 14)
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.Position = UDim2.new(fill.Size.X.Scale, 0, 0.5, 0)
		knob.BackgroundColor3 = Color3.fromRGB(240, 245, 255)
		Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

		local currentVal = def
		local dragging = false

		local function updateVal(inputX)
			local p = track.AbsolutePosition.X
			local w = track.AbsoluteSize.X
			local pct = math.clamp((inputX - p) / w, 0, 1)
			currentVal = math.floor(min + (max - min) * pct + 0.5)
			fill.Size = UDim2.new(pct, 0, 1, 0)
			knob.Position = UDim2.new(pct, 0, 0.5, 0)
			valLabel.Text = tostring(currentVal) .. suffix
			if callback then pcall(callback, currentVal) end
		end

		track.InputBegan:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				updateVal(inp.Position.X)
			end
		end)
		UserInputService.InputEnded:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
		UserInputService.InputChanged:Connect(function(inp)
			if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
				updateVal(inp.Position.X)
			end
		end)

		return {
			Set = function(self, v)
				currentVal = math.clamp(tonumber(v) or min, min, max)
				local pct = (currentVal - min) / (max - min)
				fill.Size = UDim2.new(pct, 0, 1, 0)
				knob.Position = UDim2.new(pct, 0, 0.5, 0)
				valLabel.Text = tostring(currentVal) .. suffix
				if callback then pcall(callback, currentVal) end
			end,
			Get = function() return currentVal end
		}
