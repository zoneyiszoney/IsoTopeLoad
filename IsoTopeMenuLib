	local function updateCategorySize(name)
		name = name or activeCategory
		if not name then return end
		local frame = CategoryFrames[name]
		if not frame then return end
		local layout = frame:FindFirstChildOfClass("UIListLayout")

		local function refresh()
			if activeCategory ~= name then return end
			local h = (layout and layout.AbsoluteContentSize.Y) or 0
			if h <= 20 then
				local manualH = 0
				for _, ch in ipairs(frame:GetChildren()) do
					if ch:IsA("GuiObject") and ch.Visible ~= false then
						local chH = (ch.Size.Y.Offset > 0 and ch.Size.Y.Offset) or (ch.AbsoluteSize.Y > 0 and ch.AbsoluteSize.Y) or 58
						manualH = manualH + chH + (layout and layout.Padding.Offset or 7)
					end
				end
				if manualH > h then h = manualH end
			end
			if h > 0 then
				CategoryHost.Size = UDim2.new(1, -4, 0, h + 24)
				Content.CanvasSize = UDim2.new(0, 0, 0, h + 44)
			end
		end

		refresh()
		task.defer(refresh)
		task.delay(0.03, refresh)
		task.delay(0.1, refresh)
		task.delay(0.25, refresh)
	end

	local function selectCategory(name)
		if not CategoryFrames[name] then
			name = "Home"
		end
		activeCategory = name
		for categoryName, frame in pairs(CategoryFrames) do
			frame.Visible = (categoryName == activeCategory)
		end
		Content.CanvasPosition = Vector2.zero
		updateTabVisuals()
		updateCategorySize(name)
	end

